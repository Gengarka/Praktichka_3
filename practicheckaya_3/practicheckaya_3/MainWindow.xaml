<Window x:Class="practicheckaya_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автосервис" Height="450" Width="800"
        Icon="/Resources/icon.png"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF541008">
            <Image Width="45" Height="45"
                   HorizontalAlignment="Left" Margin="10,0,0,0"
                   Source="/Resources/icon.png"/>
            <TextBlock Text="Автосервис"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Comic Sans MS"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="300">

            <TextBlock Text="Вход в систему"
                       Style="{StaticResource HeaderText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtPassword"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button Name="btnEnter"
                        Content="Войти"
                        Click="btnEnter_Click"/>
                <Button Name="btnEnterGuests"
                        Content="Войти как гость"
                        Width="160"
                        Click="btnEnterGuests_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>