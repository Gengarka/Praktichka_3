<Page x:Class="practicheckaya_3.Pages.Client"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Клиент" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF541008">
            <Image Width="45" Height="45"
                   HorizontalAlignment="Left" Margin="10,0,0,0"
                   Source="/Resources/icon.png"/>
            <TextBlock Text="Тильт-Платеж"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Comic Sans MS"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" Height="376">

            <TextBlock Text="Вы успешно вошли!"
                       Style="{StaticResource HeaderText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <Image Width="360"
                   Height="260"
                   Stretch="Uniform"
                   Source="/Resources/meme.jpg"/>

            <TextBlock Text="Спасибо, что зашли! :)"
                       FontFamily="Comic Sans MS"
                       FontSize="16"
                       Foreground="#FF541008"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>

        </StackPanel>
    </Grid>
</Page>